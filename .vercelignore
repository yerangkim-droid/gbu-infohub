# Vercel 배포에서 제외할 파일
#
# ※ Vercel CLI 는 git 추적 여부와 무관하게 --cwd 폴더를 통째로 업로드한다.
#   .gitignore 로 막아도 배포에는 올라가므로 이 파일이 따로 필요하다.
#   실제로 이 파일이 없던 동안 https://infohub-site.vercel.app/crawl_data.json 이
#   그대로 공개 다운로드됐다(245KB). 대시보드 HTML 에 데이터가 내장돼 있어
#   사이트 동작에는 원본 JSON 이 전혀 필요 없다.

# 크롤 원본 데이터 (파이프라인이 보관용으로 복사해 두는 사본)
crawl_data.json
academic_data.json

# 백업 사본
*.bak

# 저장소 메타
.git
.gitignore
